GREENROUTE_MODE=demo
GREENROUTE_GATEWAY_KEY=replace-with-a-local-key
GREENROUTE_DATABASE=runtime/greenroute.db
GREENROUTE_UPSTREAM_URL=http://127.0.0.1:8001
GREENROUTE_UPSTREAM_KEY=demo-upstream-key
GREENROUTE_TIMEOUT_SECONDS=60
GREENROUTE_GRID_REFRESH_SECONDS=60
GREENROUTE_GRID_MAX_AGE_SECONDS=300
GREENROUTE_GRID_TIMEOUT_SECONDS=5
GREENROUTE_PENDING_JOB_LIMIT=1000
GREENROUTE_WORKER_CONCURRENCY=10
GREENROUTE_INTERACTIVE_CONCURRENCY=10
GREENROUTE_WORKER_POLL_SECONDS=10
GREENROUTE_RETRY_BASE_SECONDS=2
GREENROUTE_LEASE_SECONDS=120
# Optional distinct credentials; keep the JSON value shell-quoted when using source.
# GREENROUTE_CLIENT_KEYS='{"pipeline":"replace-with-a-different-key"}'
# GREENROUTE_OPERATOR_KEY=replace-with-a-separate-operator-key
GREENROUTE_BASELINE_ENDPOINT=us-east-1
GREENROUTE_ENERGY_KWH_PER_1000_TOKENS=0.001
GREENROUTE_ENERGY_MODEL_VERSION=illustrative-v1
GREENROUTE_MOCK_DELAY_SECONDS=0

# Live runtime uses a separate database and reviewed manifest; see guides/live-integration.md.
# GREENROUTE_MODE=live
# GREENROUTE_DATABASE=runtime/live.db
# GREENROUTE_LIVE_MANIFEST=/absolute/path/to/reviewed-endpoints.json
# GREENROUTE_ELECTRICITYMAPS_API_KEY=configure-securely-outside-version-control
# Set each regional key using the environment name declared in the manifest.
